# Reference only: copy to services/api/.env for backend use.
APP_ENV=development
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Leave empty for liveness-only development; required in staging/production.
DATABASE_URL=
CORS_ORIGINS=http://localhost:8080
# Empty means forwarding headers are untrusted. Configure verified ingress CIDRs only.
TRUSTED_PROXY_CIDRS=
# Private credential adapter; opt-in only. Local-test is forbidden in deployments.
# Railway volume setup: docs/railway-credential-storage.md
# Local setup: docs/local-credential-testing.md
DOCTOR_CREDENTIAL_STORAGE=disabled
DOCTOR_CREDENTIAL_ROOT=
DOCTOR_CREDENTIAL_KEY=
DOCTOR_CREDENTIAL_SCANNER=
DOCTOR_REQUIRED_CREDENTIALS=
DOCTOR_REGISTRATION_DEFER_DOCUMENTS=false
# Railway supplies this when a persistent volume is attached; do not fake it.
RAILWAY_VOLUME_MOUNT_PATH=
# Flutter uses --dart-define; never put any secret in Flutter configuration.
API_BASE_URL=http://localhost:3000/api/v1
# Explicit opt-in only on local development/test. Never use in staging/production.
OTP_MODE=disabled
# Dummy-data hosted testing only: APP_ENV=staging, NODE_ENV=production,
# OTP_MODE=testing. Returns a code to Patient debug clients; no SMS.
# Never use a database containing real users with this mode.
# Generate a random value of at least 32 characters before enabling development OTP.
SESSION_SECRET=
# Reserved for later integration phases.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AI_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Phase 2 local demo only. Both are rejected in staging/production.
DEMO_PROGRAMS=false
PAYMENT_MODE=disabled
# Phase 3 local demos only; rejected in staging/production.
DEMO_CONSULTATIONS=false
CANCELLATION_WINDOW_MINUTES=120
BOOKING_HOLD_MINUTES=10
# Reserved adapters: setting keys does not enable an unimplemented provider.
RAZORPAY_WEBHOOK_SECRET=
VIDEO_PROVIDER_KEY=
VIDEO_PROVIDER_SECRET=
# Phase 4: local-only demo catalogue; forbidden in deployed environments.
DEMO_WELLNESS=false
ORDER_HOLD_MINUTES=10
ORDER_CANCEL_CONFIRMED=true
# Shipping/tax/refund providers remain unconfigured. No real sales are enabled.

# Phase 5. Development responses are local-only; disabled is the safe default.
AI_PROVIDER=disabled
AI_MODEL=
AI_TIMEOUT_MS=8000
AI_MAX_OUTPUT_TOKENS=256
# AI_API_KEY above is backend-only. Never use it in a Flutter dart-define.
# Official signed webhook contract. Outbound notifications need explicit opt-in.
WHATSAPP_MODE=disabled
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Phase 6 reuses PAYMENT_MODE; no separate payment secrets or client prices.
# membership:seed requires development/test + PAYMENT_MODE=development.
# Plan prices, benefits, trials, grace policy and coupons live in PostgreSQL.
# Production recurring billing, tax rules and provider refunds are unconfigured.

# Phase 7. Development admin access is local/test only; deployments require totp or disabled.
ADMIN_SECURITY_MODE=disabled
# Secret-store JSON mapping existing administrator UUIDs to per-account base32 keys.
ADMIN_TOTP_KEYS={}
# Approved policy metadata only: [{"type":"PRIVACY","version":"...","url":"https://...","approved":true}]
# Leave empty until business/legal approval; do not invent approved documents.
LEGAL_DOCUMENTS=[]
WHATSAPP_OUTBOUND=disabled
WHATSAPP_API_VERSION=
# Keys alone do not activate checkout or recurring billing. See production-config.md.
# Backup settings are used only by scripts/backup-database.ts, never the mobile app.
BACKUP_FILE=
PG_DUMP_PATH=

# P7-A optional provider adapters. Disabled by default; use separate sandbox/live accounts.
# OTP_MODE=provider requires an approved SMS sender/template; no code is returned to clients.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Use the approved transactional SMS template containing exactly one {code} placeholder.
SMS_OTP_TEMPLATE=
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
PUSH_PROVIDER=disabled
# Private service-account JSON from Firebase, never generated or embedded in Flutter.
FCM_SERVICE_ACCOUNT_JSON=
# Private 32-byte random key encoded as base64 for encrypted registration tokens.
NOTIFICATION_ENCRYPTION_KEY=
# Meta account ownership reference; phone-number ID remains the current webhook boundary.
WHATSAPP_BUSINESS_ID=
